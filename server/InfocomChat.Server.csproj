<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>netcoreapp3.1</TargetFramework>
	<!-- Отключение автоматического включения Content-файлов (если нужно) -->
	<EnableDefaultContentItems>false</EnableDefaultContentItems>
	<AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <RootNamespace>InfocomChat.Server</RootNamespace>
    <AssemblyName>InfocomChat.Server</AssemblyName>
    <Version>6.0.0</Version>
    <Authors>Infocom LM Chat Team</Authors>
    <Description>Real-time chat server for Infocom LM Chat Pro v6.0</Description>
    <Copyright>© 2026 Infocom LM Chat</Copyright>
    <PackageId>InfocomChat.Server</PackageId>
  </PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="3.1.15" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="3.1.15">
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		  <PrivateAssets>all</PrivateAssets>
		</PackageReference>

		<!-- SQLite -->
		<!-- <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="3.1.15" />-->

		<!-- SQL Server -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="3.1.15" />

		<!-- PostgreSQL -->
		<!-- <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="3.1.15" />-->
	</ItemGroup>

  <!-- Для работы с базой данных (опционально) -->
  <!--
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="3.1.32" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="3.1.32" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="3.1.32" />
  </ItemGroup>
  -->

  <!-- Статические файлы для клиентской части -->
  <ItemGroup>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Конфигурационные файлы -->
  <ItemGroup>
    <None Update="web.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <DependentUpon>appsettings.json</DependentUpon>
    </None>
  </ItemGroup>

  <!-- Настройки для Release сборки -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Настройки для Windows и IIS -->
  <PropertyGroup>
    <UseWindowsHosting>true</UseWindowsHosting>
    <AspNetCoreModuleName>AspNetCoreModuleV2</AspNetCoreModuleName>
  </PropertyGroup>

  <!-- Настройки для публикации -->
  <PropertyGroup>
    <PublishWithAspNetCoreTargetManifest>false</PublishWithAspNetCoreTargetManifest>
  </PropertyGroup>

</Project>