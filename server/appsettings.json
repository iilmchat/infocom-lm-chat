{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ChatSettings": {
    "MaxMessageLength": 10000,
    "MaxHistoryMessages": 1000,
    "MaxRoomUsers": 50,
    "CleanupIntervalSeconds": 60,
    "DefaultRoomTimeoutMinutes": 60,
    "PollingTimeoutSeconds": 30,
    "TypingTimeoutSeconds": 3,
    "InactiveTimeoutMinutes": 5
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:8034",
      "http://222.1.1.31:8034"
    ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Content-Type", "Authorization", "X-Requested-With" ]
  },
  "ConnectionStrings": {
    "MSSQL": "Server=YOUR_SERVER;Database=YOUR_DB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;",
    "DefaultConnection": "Server=YOUR_SERVER;Database=YOUR_DB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;"
  },
  "AllowedHosts": "*",
  "Database": {
    "Type": "SqlServer",
    "SQLitePath": "Data/chat.db",
    "AutoMigrate": true,
    "CommandTimeout": 30,
    "EnableSensitiveDataLogging": false
  },
  "Server": {
    "Port": 8032,
    "DefaultRole": "Admin",
    "MaxUsersPerRoom": 50,
    "MaxMessageLength": 10000,
    "InactiveTimeoutMinutes": 5,
    "MaxHistoryMessages": 1000,
    "AllowGuestUsers": true,
    "EnableRegistration": true
  },
  "LM": {
    "IP": "222.1.1.31",
    "Port": 8034,
    "Timeout": 60,
    "MaxTokens": 2048,
    "ApiPath": "/v1/chat/completions"
  }
}